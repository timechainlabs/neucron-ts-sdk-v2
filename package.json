{
    "name": "@timechainlabs/neucron-ts-sdk",
    "version": "2.1.0",
    "description": "Wallet infrastructure SDK for fintechs: MPC wallets, smart accounts, stablecoin payments (USDC/USDT), mass payouts, invoicing, subscriptions, policy controls, KYC/KYB, approval workflows, and 50+ blockchain rails. Non-custodial or custodial. Sign up at console.neucron.io.",
    "keywords": [
        "neucron",
        "wallet-infrastructure",
        "mpc-wallet",
        "smart-accounts",
        "stablecoin",
        "usdc",
        "usdt",
        "payments",
        "payouts",
        "mass-payouts",
        "invoicing",
        "subscriptions",
        "billing",
        "fintech",
        "custody",
        "non-custodial",
        "wallet-as-a-service",
        "waas",
        "blockchain",
        "multichain",
        "evm",
        "polygon",
        "tron",
        "tokenized-assets",
        "security-tokens",
        "kyc",
        "kyb",
        "compliance",
        "policy-engine",
        "approval-workflows",
        "agentic-wallets",
        "server-wallets",
        "paymaster",
        "typescript-sdk",
        "api-client"
    ],
    "homepage": "https://timechain.gitbook.io/neucron-javascript-sdk/",
    "bugs": {
        "url": "https://github.com/timechainlabs/neucron-ts-sdk-v2/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/timechainlabs/neucron-ts-sdk-v2.git"
    },
    "license": "MIT",
    "author": "Timechain Labs <rohan@timechainlabs.io> (https://timechainlabs.io)",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "react-native": "./dist/index.js",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        },
        "./schemas": {
            "types": "./dist/schemas.d.ts",
            "import": "./dist/schemas.js",
            "require": "./dist/schemas.cjs",
            "default": "./dist/schemas.js"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "build": "tsdown --config-loader native",
        "prepublishOnly": "npm run build",
        "typecheck": "tsc --noEmit",
        "dev": "ts-node src/index.ts",
        "test": "vitest",
        "test:unit": "vitest run --dir=tests/unit",
        "test:integration": "vitest run --dir=tests/integration",
        "test:run": "npm run test:unit && npm run test:integration",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest --watch",
        "test:ui": "vitest --ui",
        "lint": "eslint . --ext .js,.ts,.jsx,.tsx",
        "lint:fix": "eslint . --ext .js,.ts,.jsx,.tsx --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "prepare": "husky"
    },
    "dependencies": {
        "axios": "^1.18.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.2",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.8.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.5",
        "ts-node": "^10.9.2",
        "tsdown": "^0.22.5",
        "typescript": "~5.8.0",
        "typescript-eslint": "^8.63.0",
        "vitest": "^4.1.10"
    },
    "react-native": "./dist/index.js"
}
